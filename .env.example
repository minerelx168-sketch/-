# Database
DB_HOST=localhost
DB_NAME=imei_checker
DB_USER=root
DB_PASS=

# External IMEI API
#
# Supported providers:
#   - demo            in-memory TAC database (no external call, no key needed)
#   - unlock-service  https://api.unlock-service.net/?service=X&imei=Y&key=Z
#                     (service list: https://unlock-service.net/instantservices.php)
#   - imei.info       https://imei.info/api/check/{service}/{imei}/?API_KEY=...
#   - sickw           https://sickw.com/api.php?key=...&imei=...&service=...
#
# IMEI_API_DEFAULT_SERVICE is the service ID from your provider's dashboard.
IMEI_API_PROVIDER=unlock-service
IMEI_API_KEY=replace-with-your-key
# Username is only needed for async DHRU services (placeimeiorder /
# getimeiorder, used by GSX Picture and other 1-5+ min services).
# The synchronous PHP API works with the key alone.
IMEI_API_USERNAME=
IMEI_API_URL=https://api.unlock-service.net
IMEI_API_DEFAULT_SERVICE=1

# App
APP_DEBUG=false
APP_NAME="imeihub"
APP_URL=http://localhost:8080

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys)
# Use sk_test_/pk_test_ for sandbox, sk_live_/pk_live_ for production.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Orders v2 (https://developer.paypal.com/dashboard/applications)
# Set PAYPAL_ENV=sandbox while testing, then flip to "live" for production.
# Webhook URL to register in the PayPal dashboard:
#   https://<your-domain>/api/webhooks/paypal.php
# Subscribe to events: "CHECKOUT.ORDER.APPROVED" and "PAYMENT.CAPTURE.COMPLETED".
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Binance Pay Merchant API (https://merchant.binance.com)
# Apply for a merchant account, then generate API key + secret. Webhook URL:
#   https://<your-domain>/api/webhooks/binancepay.php
# Configure it under Merchant Center > Developer > Webhook.
BINANCE_PAY_KEY=
BINANCE_PAY_SECRET=
# Optional - override base URL for testing.
# BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com

# Session
SESSION_LIFETIME_DAYS=30
SESSION_COOKIE_NAME=imeihub_sid

# Telegram Bot (https://core.telegram.org/bots#botfather)
# Create via @BotFather, copy the token below. Then pick any random secret
# string and register the webhook URL:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<your-domain>/api/webhooks/telegram.php?s=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# LINE Messaging API (https://developers.line.biz/console/)
# Create a Messaging API channel. Webhook URL:
#   https://<your-domain>/api/webhooks/line.php
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Resend (https://resend.com/api-keys)
# Used to send signup OTP emails. The "from" address must be either
# onboarding@resend.dev (testing only, limited to your own email) OR
# a verified domain you own.
RESEND_API_KEY=
RESEND_FROM="onboarding@resend.dev"

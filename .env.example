# Database
DB_HOST=localhost
DB_NAME=imei_checker
DB_USER=root
DB_PASS=

# External IMEI API
#
# Supported providers:
#   - imei.info  -> URL https://imei.info/api/check    (path-based)
#   - sickw      -> URL https://sickw.com/api.php      (query-based)
#
# IMEI_API_DEFAULT_SERVICE is the service / type ID from your provider's
# dashboard (e.g. "Basic Info"). Check your account for the list.
IMEI_API_PROVIDER=imei.info
IMEI_API_KEY=replace-with-your-key
IMEI_API_URL=https://imei.info/api/check
IMEI_API_DEFAULT_SERVICE=0

# App
APP_DEBUG=false
APP_NAME="imeicheck"

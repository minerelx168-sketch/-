# Database
DB_HOST=localhost
DB_NAME=imei_checker
DB_USER=root
DB_PASS=

# External IMEI API (sickw.com style)
# Sign up at https://sickw.com or https://imei.info to get an API key.
IMEI_API_PROVIDER=sickw
IMEI_API_KEY=replace-with-your-key
IMEI_API_URL=https://sickw.com/api.php
IMEI_API_DEFAULT_SERVICE=0

# App
APP_DEBUG=false
APP_NAME="Base IMEI Checker"

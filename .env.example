# Database
DB_HOST=localhost
DB_NAME=imei_checker
DB_USER=root
DB_PASS=

# External IMEI API
#
# Supported providers:
#   - imei.info  -> URL https://imei.info/api/check    (path-based)
#   - sickw      -> URL https://sickw.com/api.php      (query-based)
#
# IMEI_API_DEFAULT_SERVICE is the service / type ID from your provider's
# dashboard (e.g. "Basic Info"). Check your account for the list.
IMEI_API_PROVIDER=imei.info
IMEI_API_KEY=replace-with-your-key
IMEI_API_URL=https://imei.info/api/check
IMEI_API_DEFAULT_SERVICE=0

# App
APP_DEBUG=false
APP_NAME="imeicheck"
APP_URL=http://localhost:8080

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys)
# Use sk_test_/pk_test_ for sandbox, sk_live_/pk_live_ for production.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Session
SESSION_LIFETIME_DAYS=30
SESSION_COOKIE_NAME=imeicheck_sid
